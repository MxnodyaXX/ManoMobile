# Copy to .env.local and fill in the real values. This file is a TEMPLATE and is
# committed to git — keep placeholders here, never your project's actual keys.
#
# Restart `npm run dev` after changing anything: NEXT_PUBLIC_* values are inlined
# at build time, so a running dev server keeps the old ones.

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is safe in the browser — Row Level Security is what protects the
# data. Never put the service_role key in a NEXT_PUBLIC_ variable: it bypasses
# RLS entirely and would be shipped to every visitor in the JS bundle.

# ── Service role (Project Settings → API → service_role) ─────────────────────
# Needed only so an Admin can create staff logins from Admin → Staff: minting an
# auth user is not something the anon key may do.
#
# NO NEXT_PUBLIC_ PREFIX, EVER. This key bypasses Row Level Security completely —
# in a browser bundle it would hand every visitor full read/write on your data.
# It is read only by the server route at /api/staff.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SMS gateway (Text.lk) ────────────────────────────────────────────────────
# From https://app.text.lk → Developers / API tokens.
#
# NO NEXT_PUBLIC_ PREFIX ON PURPOSE. This token can spend money. It is read only
# by the server route at /api/sms/send; prefixing it would ship it to every
# visitor's browser, where anyone could drain the SMS balance.
TEXTLK_API_TOKEN=your-text-lk-api-token

# The approved Sender ID shown as the "From" on the customer's handset.
# Alphanumeric, 11 characters max.
TEXTLK_SENDER_ID=Mano Mobile
