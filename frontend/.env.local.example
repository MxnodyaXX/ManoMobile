# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Restart `npm run dev` after changing these: NEXT_PUBLIC_* values are inlined
# at build time, so a running dev server keeps the old ones.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is safe in the browser — Row Level Security is what protects the
# data. Never put the service_role key in a NEXT_PUBLIC_ variable: it bypasses
# RLS entirely and would be shipped to every visitor in the JS bundle.
