# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template carries no secrets and every new checkout needs it
!.env.local.example

# supabase cli scratch (keep migrations/ and seed.sql tracked)
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .NET build output (backend)
bin/
obj/

# visual studio ide state
.vs/

# editor session state
.emrac-session.json

# Local backups: customer names, phone numbers, emails and device details.
# Never committed. The README is kept so the restore steps live in git.
/backups/*
!/backups/README.md
